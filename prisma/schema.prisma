// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "./prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Build {
  id        String   @id @default(cuid())
  buildId   String   @unique // 6-character random ID for public access
  
  // App metadata (extracted from Info.plist)
  appName           String
  bundleId          String
  version           String
  buildNumber       String
  displayName       String?
  minOSVersion      String?
  
  // File paths in storage
  ipaPath           String   // Path to .ipa file in MinIO/S3
  iconPath          String?  // Path to app icon
  plistPath         String   // Path to manifest.plist for itms-services
  
  // Upload info
  originalFileName  String   // Original .ipa filename
  fileSize         BigInt   // File size in bytes
  
  // Status and settings
  status           BuildStatus @default(PROCESSING)
  isEnabled        Boolean     @default(true)
  
  // Download limits
  maxDownloads     Int?        // Maximum number of downloads allowed
  downloadCount    Int         @default(0)
  
  // Expiry settings
  expiresAt        DateTime?   // When the build expires
  autoDelete       Boolean     @default(true) // Auto delete when expired
  
  // Tags and notes
  tag              String?     // Optional tag for version
  notes            String?     // Optional notes
  
  // Timestamps
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  
  // Relations
  downloads        Download[]
  
  @@map("builds")
}

model Download {
  id          String   @id @default(cuid())
  buildId     String
  
  // Download info
  userAgent   String?
  ipAddress   String?
  downloadedAt DateTime @default(now())
  
  // Relations
  build       Build    @relation(fields: [buildId], references: [id], onDelete: Cascade)
  
  @@map("downloads")
}

model ProcessingJob {
  id          String      @id @default(cuid())
  buildId     String      @unique
  jobId       String      @unique // Bull.js job ID
  
  status      JobStatus   @default(PENDING)
  progress    Int         @default(0) // 0-100
  
  // Error handling
  error       String?
  retryCount  Int         @default(0)
  maxRetries  Int         @default(3)
  
  // Timestamps
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  startedAt   DateTime?
  completedAt DateTime?
  
  @@map("processing_jobs")
}

enum BuildStatus {
  PROCESSING  // Being processed by worker
  READY       // Ready for download
  EXPIRED     // Expired but not yet deleted
  DISABLED    // Manually disabled
  ERROR       // Processing failed
}

enum JobStatus {
  PENDING     // Waiting to be processed
  ACTIVE      // Currently being processed
  COMPLETED   // Successfully completed
  FAILED      // Failed to process
  DELAYED     // Delayed for retry
}


