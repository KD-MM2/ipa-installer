// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "./prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Build {
  id        String   @id @default(cuid())
  buildId   String   @unique // 6-character random ID for public access
  
  // App metadata (extracted from Info.plist)
  appName           String
  bundleId          String
  version           String
  buildNumber       String
  displayName       String?
  minimumOSVersion  String?
  
  // File info
  originalFilename  String   // Original .ipa filename
  fileSize         BigInt   // File size in bytes
  hasIcon          Boolean  @default(false) // Whether icon.png exists
  
  // Status and settings
  status           String   @default("processing") // processing, active, expired, failed
  
  // Download limits
  maxDownloads     Int?        // Maximum number of downloads allowed
  downloadCount    Int         @default(0)
  
  // Expiry settings
  expiresAt        DateTime?   // When the build expires
  
  // Timestamps
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  
  @@map("builds")
}




