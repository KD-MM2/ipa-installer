{
    "name": "ipa-installer-next",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build && tsc -p tsconfig.worker.json",
        "start": "next start",
        "lint": "eslint",
        "format": "prettier --write .",
        "workers": "tsx src/workers/index.ts",
        "workers:dev": "tsx watch src/workers/index.ts",
        "db:bootstrap": "prisma migrate deploy && prisma db push",
        "dev:all": "npm-run-all --parallel dev workers:dev",
        "start:all": "sh -c '[ -f /app/data/data.db ] || (pnpx prisma migrate deploy && pnpx prisma db push); npm-run-all --parallel start workers'"
    },
    "dependencies": {
        "@prisma/client": "6.14.0",
        "@typescript-eslint/parser": "^8.40.0",
        "axios": "^1.11.0",
        "bullmq": "^5.58.0",
        "minio": "^8.0.5",
        "next": "15.5.0",
        "plist": "^3.1.0",
        "primeicons": "^7.0.0",
        "primereact": "^10.9.7",
        "qrcode": "^1.5.4",
        "react": "19.1.0",
        "react-dom": "19.1.0",
        "react-transition-group": "^4.4.5",
        "redis": "^5.8.1",
        "sharp": "^0.34.3"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3",
        "@tailwindcss/postcss": "^4",
        "@trivago/prettier-plugin-sort-imports": "^5.2.2",
        "@types/node": "^20",
        "@types/plist": "^3.0.5",
        "@types/qrcode": "^1.5.5",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "dotenv": "^17.2.1",
        "eslint": "^9",
        "eslint-config-next": "15.5.0",
        "npm-run-all": "^4.1.5",
        "prettier": "^3.6.2",
        "prisma": "^6.14.0",
        "tailwindcss": "^4",
        "tsx": "^4.20.4",
        "typescript": "^5"
    }
}
