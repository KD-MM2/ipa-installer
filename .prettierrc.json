{
    "useTabs": false,
    "tabWidth": 4,
    "trailingComma": "none",
    "semi": true,
    "singleQuote": true,
    "printWidth": 250,
    "bracketSameLine": false,
    "importOrder": ["^(.*)react(.*)$", "^~/components/(.*)$", "^~/hooks/(.*)$", "^~/utils/(.*)$", "^~/api/(.*)$", "^~/primereact/(.*)$", "^[./]"],
    "importOrderSeparation": true,
    "importOrderSortSpecifiers": true,
    "plugins": ["@trivago/prettier-plugin-sort-imports"]
}
